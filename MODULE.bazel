bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_dotnet", version = "0.20.5")
bazel_dep(name = "rules_oci", version = "2.2.7")
bazel_dep(name = "rules_pkg", version = "1.0.1")

dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "8.0.415")
use_repo(dotnet, "dotnet_toolchains")

register_toolchains("@dotnet_toolchains//:all")

main_extension = use_extension("//deps:paket.main_extension.bzl", "main_extension")
use_repo(main_extension, "paket.main")

buildx = use_extension("@@//:buildx.bzl", "buildx")
buildx.toolchains()
use_repo(buildx, "buildx")
